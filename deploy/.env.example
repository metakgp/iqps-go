# ---------- Database ----------
DB_NAME=iqps
DB_USER=iqps
DB_PASSWORD=change-me-to-a-long-random-password

# ---------- Admin login (GitHub) ----------
GH_CLIENT_ID=
GH_CLIENT_SECRET=
# Comma-separated GitHub usernames of student admins
GH_ADMIN_USERNAMES=admin1,admin2
# Optional: also allow every member of a GitHub org team (leave empty if not used)
GH_ORG_NAME=
GH_ORG_TEAM_SLUG=
# Long random string, e.g. output of: openssl rand -hex 32
JWT_SECRET=

# ---------- URLs ----------
# Public URL of this server (where nginx serves /iqps/ PDFs). Must end with /
STATIC_FILES_URL=https://pyq.iitbhilai.ac.in/
# Where the frontend is served (this server, or your Vercel URL)
FRONTEND_URL=https://pyq.iitbhilai.ac.in
# Comma-separated origins allowed to call the API (add your Vercel URL if the frontend is there)
CORS_ALLOWED_ORIGINS=https://pyq.iitbhilai.ac.in,http://localhost:5173

# ---------- Other ----------
MAX_UPLOAD_LIMIT=10
# Optional: Slack incoming webhook to notify admins about new uploads
SLACK_WEBHOOK_URL=
# Host port nginx listens on
HTTP_PORT=80
